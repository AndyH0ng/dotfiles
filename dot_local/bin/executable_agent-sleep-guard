#!/bin/bash
# Keeps the Mac awake through a lid close while Claude Code or Codex is working.
# Claude uses caffeinate; Codex's prevent_idle_sleep owns a macOS power assertion.
# Closing the lid sleeps the Mac regardless; `pmset disablesleep` needs root
# (/etc/sudoers.d/agent-sleep-guard allows exactly the two calls below).
# A LaunchAgent runs this every 30s (run_after_agent-sleep-guard.sh.tmpl).
set -uo pipefail

working() {
  local pid ppid
  # Codex uses a native IOPM assertion, not necessarily a caffeinate subprocess.
  pmset -g assertions | awk '
    /pid [0-9]+\(codex\):/ && /PreventUserIdleSystemSleep/ { found=1 }
    END { exit !found }
  ' && return 0
  for pid in $(pgrep -x caffeinate); do
    ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
    case "$(basename "$(ps -o comm= -p "$ppid")")" in
      claude|codex) return 0 ;;
    esac
  done
  return 1
}

# Read-only diagnostic, also usable without sudoers installed.
if [ "${1:-}" = --check ]; then working; exit $?; fi

grace_min=${AGENT_SLEEP_GUARD_GRACE_MIN:-5}
batt_floor=${AGENT_SLEEP_GUARD_BATT_FLOOR:-30}
sudo -n -l /usr/bin/pmset -a disablesleep 1 >/dev/null 2>&1 || exit 0
state="${XDG_STATE_HOME:-$HOME/.local/state}/agent-sleep-guard"
mkdir -p "$state"
now=$(date +%s)

# written as `disablesleep`, read back as `SleepDisabled`
held() { [ "$(pmset -g | awk '$1 == "SleepDisabled" { print $2 }')" = 1 ]; }

set_sleep() {
  local want=$1 cur=0
  held && cur=1
  [ "$cur" = "$want" ] && return 0
  sudo -n /usr/bin/pmset -a disablesleep "$want" \
    && echo "$(date '+%F %T') disablesleep=$want: $2"
}

working && echo "$now" >"$state/last-working"
last=$(cat "$state/last-working" 2>/dev/null || echo 0)
batt=$(pmset -g batt)
pct=$(printf '%s' "$batt" | grep -o '[0-9]*%' | tr -d %)

if ! printf '%s' "$batt" | grep -q "AC Power" && [ "${pct:-100}" -lt "$batt_floor" ]; then
  set_sleep 0 "battery ${pct}% < ${batt_floor}%"
elif [ $((now - last)) -lt $((grace_min * 60)) ]; then
  set_sleep 1 "agent working"
else
  set_sleep 0 "idle ${grace_min}m"
fi
