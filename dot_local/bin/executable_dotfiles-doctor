#!/bin/sh
# Report drift between ~/dotfiles and this machine. Changes nothing.
#   dotfiles-doctor --json   for agents; exit 1 on drift
src=$(chezmoi source-path)

# chezmoi
chezmoi_drift=$(chezmoi status --exclude scripts)
# symlinks into the repo whose source is gone (deleted without .chezmoiremove)
dangling=$(chezmoi managed -i files -p absolute | sed 's|/[^/]*$||' | sort -u \
  | while read -r d; do find "$d" -maxdepth 1 -type l -lname "$src/*" ! -exec test -e {} \; -print; done)

# brew
data=$(chezmoi data --format json)
active="$src/packages/Brewfile"
for g in $(printf '%s' "$data" | jq -r '.install as $on | .groups[] | select($on[.name] == true) | .name'); do
  active="$active $src/packages/Brewfile.$g"
done
all_brewfile=$(mktemp); active_brewfile=$(mktemp)
trap 'rm -f "$all_brewfile" "$active_brewfile"' EXIT
cat "$src"/packages/Brewfile "$src"/packages/Brewfile.* > "$all_brewfile"
# shellcheck disable=SC2086
cat $active > "$active_brewfile"

brew_missing=$(brew bundle check --file="$active_brewfile" --no-upgrade --verbose 2>/dev/null \
  | sed -n 's/^→ [A-Za-z]* \(.*\) needs to be installed.*/\1/p')
# installed on request but not listed anywhere (informational)
requested=$( { brew leaves --installed-on-request; brew list --cask -1; } 2>/dev/null)
brew_unlisted=$(brew bundle cleanup --file="$all_brewfile" 2>/dev/null | grep -vE '^(Would|Run )' \
  | while read -r pkg; do printf '%s\n' "$requested" | grep -qx "${pkg##*/}" && echo "$pkg"; done)

# uv tools
installed_uv=$(uv tool list 2>/dev/null | awk '/^[^ -]/ {print $1}')
uv_missing=$(grep -vE '^\s*(#|$)' "$src/uv-tools.txt" | while read -r t; do
  printf '%s\n' "$installed_uv" | grep -qx "$t" || echo "$t"; done)

# theme palette vs tinty's scheme
scheme=$(printf '%s' "$data" | jq -r '.theme.scheme')
scheme_yaml="$HOME/.local/share/tinted-theming/tinty/repos/schemes/${scheme%%-*}/${scheme#*-}.yaml"
if [ -f "$scheme_yaml" ]; then
  theme_mismatch=$(printf '%s' "$data" | jq -r '.theme.palette | to_entries[] | "\(.key) \(.value)"' \
    | while read -r k v; do
        want=$(sed -n "s/^ *$k: *\"#\{0,1\}\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$scheme_yaml" | tr A-F a-f)
        [ "$want" = "$(printf '%s' "$v" | tr A-F a-f)" ] || echo "$k: theme.toml=$v $scheme=$want"
      done)
else
  theme_mismatch="scheme file not found: $scheme_yaml (run tinty install)"
fi

# fonts
ghostty_bin=$(command -v ghostty || echo /Applications/Ghostty.app/Contents/MacOS/ghostty)
ghostty_fonts=$("$ghostty_bin" +list-fonts 2>/dev/null)
font_mismatch=$(printf '%s' "$data" | jq -r '.theme.font.families[] | "\(.cask)\t\(.name)"' \
  | while IFS="$(printf '\t')" read -r cask name; do
      grep -q "^cask \"$cask\"" "$src/packages/Brewfile" || echo "$cask (for \"$name\") is not in packages/Brewfile"
      if [ -n "$ghostty_fonts" ]; then
        printf '%s\n' "$ghostty_fonts" | grep -qx "$name" || echo "Ghostty can't find font family \"$name\""
      fi
    done)

# Claude Code settings (true when the claude group is off)
claude_sync=true
if [ "$(printf '%s' "$data" | jq -r '.install.claude // false')" = true ]; then
  "$HOME/.local/bin/claude-sync" --check || claude_sync=false
fi

# chrome-devtools MCP
mcp_missing=
if [ "$(printf '%s' "$data" | jq -r '.install.claude == true and .install.canary == true')" = true ]; then
  jq -e '.mcpServers["chrome-devtools"].args | index("--autoConnect")' "$HOME/.claude.json" >/dev/null 2>&1 \
    || mcp_missing=chrome-devtools
fi

# Codex checks owned keys only; never print private config or require authentication.
codex_sync=true
codex_missing=
if [ "$(printf '%s' "$data" | jq -r '.install.codex // false')" = true ]; then
  command -v codex >/dev/null 2>&1 || codex_missing=codex
  uv run --script "$src/scripts/codex_config.py" --check --file "$HOME/.codex/config.toml" \
    || codex_sync=false
fi

# GUI-launched agents may inherit only the system PATH. Check both shell modes.
shell_missing=$(for mode in -c -lc; do
  # shellcheck disable=SC2016 # expanded by the child zsh, not this shell
  env -i HOME="$HOME" USER="$(id -un)" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    /bin/zsh "$mode" 'for tool in brew mise node bun pnpm uv git; do
      command -v "$tool" >/dev/null || print -r -- "$tool"; done' \
    | while read -r tool; do echo "$mode: $tool"; done
done)

# telemetry (env checked in a non-interactive shell: what agents get)
telemetry_off=$(printf '%s' "$data" | jq -r '.telemetry.env | to_entries[] | "\(.key)=\(.value)"' \
  | while IFS='=' read -r k v; do
      [ "$(zsh -c "printenv $k")" = "$v" ] || echo "env $k not set to $v in non-interactive zsh"
    done)
telemetry_off="$telemetry_off$(printf '%s' "$data" | jq -c '.telemetry.commands[]' | while read -r c; do
  tool=$(printf '%s' "$c" | jq -r .tool)
  command -v "$tool" >/dev/null 2>&1 || continue
  sh -c "$(printf '%s' "$c" | jq -r .check)" >/dev/null 2>&1 || printf '\n%s telemetry is on' "$tool"
done)"
telemetry_off=$(printf '%s' "$telemetry_off" | sed '/^$/d')

# macOS defaults (bools read back as 1/0)
macos_mismatch=$(printf '%s' "$data" | jq -r '.macos.defaults[]
    | [.domain, .key, (if .value == true then "1" elif .value == false then "0" else (.value | tostring) end)] | @tsv' \
  | while IFS="$(printf '\t')" read -r domain key want; do
      got=$(defaults read "$domain" "$key" 2>/dev/null)
      [ "$got" = "$want" ] || echo "$domain $key: want $want, got ${got:-unset}"
    done)
macos_mismatch="$macos_mismatch$(printf '%s' "$data" | jq -r '.install as $on | .macos.default_apps[]
    | select($on[.group] == true) | .app as $app | .extensions[] | "\($app)\t\(.)"' \
  | while IFS="$(printf '\t')" read -r app ext; do
      got=$(duti -x "$ext" 2>/dev/null | sed -n 3p)
      [ "$got" = "$app" ] || printf '\n.%s opens with %s, want %s' "$ext" "${got:-nothing}" "$app"
    done)"
macos_mismatch=$(printf '%s' "$macos_mismatch" | sed '/^$/d')

# git
git -C "$src" fetch -q 2>/dev/null
git_status=$(git -C "$src" status --short)
ahead=$(git -C "$src" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
behind=$(git -C "$src" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)

ok=true
# brew_unlisted is informational, so it doesn't fail
[ -n "$chezmoi_drift$dangling$brew_missing$uv_missing$theme_mismatch$font_mismatch$telemetry_off$macos_mismatch$mcp_missing$codex_missing$shell_missing$git_status" ] && ok=false
[ "$claude_sync" = false ] || [ "$codex_sync" = false ] || [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ] && ok=false

lines() { printf '%s\n' "$1" | jq -R . | jq -s 'map(select(length > 0))'; }

if [ "${1:-}" = "--json" ]; then
  jq -n \
    --argjson ok "$ok" \
    --argjson chezmoi "$(lines "$chezmoi_drift")" \
    --argjson dangling "$(lines "$dangling")" \
    --argjson missing "$(lines "$brew_missing")" \
    --argjson unlisted "$(lines "$brew_unlisted")" \
    --argjson uv "$(lines "$uv_missing")" \
    --argjson theme "$(lines "$theme_mismatch")" \
    --argjson telemetry "$(lines "$telemetry_off")" \
    --argjson fonts "$(lines "$font_mismatch")" \
    --argjson macos "$(lines "$macos_mismatch")" \
    --arg src "$src" \
    --argjson claude "$claude_sync" \
    --argjson mcp "$(lines "$mcp_missing")" \
    --argjson codex "$codex_sync" \
    --argjson codex_missing "$(lines "$codex_missing")" \
    --argjson shell "$(lines "$shell_missing")" \
    --argjson git "$(lines "$git_status")" \
    --argjson ahead "$ahead" --argjson behind "$behind" \
    '{ok: $ok,
      chezmoi_drift: $chezmoi,
      dangling_symlinks: $dangling,
      brew: {missing: $missing, unlisted: $unlisted},
      uv_tools_missing: $uv,
      theme_mismatch: $theme,
      font_mismatch: $fonts,
      telemetry_on: $telemetry,
      macos_defaults_mismatch: $macos,
      claude_settings_in_sync: $claude,
      claude_mcp_missing: $mcp,
      codex_settings_in_sync: $codex,
      codex_missing: $codex_missing,
      shell_tools_missing: $shell,
      git: {uncommitted: $git, ahead: $ahead, behind: $behind},
      fixes: {
        chezmoi_drift: "chezmoi diff, then chezmoi apply (repo wins) or edit the repo",
        dangling_symlinks: "add each path (relative to $HOME) to .chezmoiremove, then chezmoi apply",
        brew_missing: ("brew bundle --no-upgrade --file " + $src + "/packages/Brewfile and each enabled packages/Brewfile.<group>; run_onchange does not rerun on package removal"),
        brew_unlisted: "informational only: packages you installed by hand. Do not add them to a packages/Brewfile unless the user asks",
        uv_tools_missing: "chezmoi apply (or uv tool install <name>)",
        theme_mismatch: "copy the palette for theme.scheme from the tinty scheme yaml into .chezmoidata/theme.toml",
        font_mismatch: "every theme.font.families cask must be in packages/Brewfile and its name must match `ghostty +list-fonts` exactly",
        telemetry_on: "run the matching telemetry.commands[].run from .chezmoidata/telemetry.toml; run_onchange may already be recorded",
        macos_defaults_mismatch: "chezmoi apply, or change the value in .chezmoidata/macos.toml. A key that never sticks was likely dropped by a macOS update; a default app that reverts was changed in Finder (Get Info → Open with)",
        claude_settings: "claude-sync",
        claude_mcp_missing: "run the `claude mcp add` line from run_onchange_before_install-packages.sh.tmpl (run_onchange, so chezmoi apply alone does not rerun it)",
        codex_settings: "chezmoi apply ~/.codex/config.toml (merges owned settings and Canary MCP; preserves personal settings)",
        codex_missing: ("brew bundle --no-upgrade --file " + $src + "/packages/Brewfile.codex"),
        shell_tools_missing: "chezmoi apply ~/.zshenv ~/.zprofile; mise install --locked; mise reshim",
        git_behind: "chezmoi update"
      }}'
else
  section() { printf '\n\033[1m%s\033[0m\n' "$1"; }
  show() { if [ -n "$1" ]; then printf '%s\n' "$1" | sed 's/^/  /'; else echo "  none"; fi; }
  section "chezmoi: files that differ from the repo"; show "$chezmoi_drift"
  section "symlinks into the repo whose source is gone"; show "$dangling"
  section "Brewfiles (opted-in): listed but not installed"; show "$brew_missing"
  section "Brewfiles: installed but not listed (informational)"; show "$(printf '%s' "$brew_unlisted" | tr '\n' ' ')"
  section "uv tools: listed but not installed"; show "$uv_missing"
  section "theme.toml palette vs tinty scheme"; show "$theme_mismatch"
  section "terminal fonts (theme.toml vs packages/Brewfile and Ghostty)"; show "$font_mismatch"
  section "telemetry (.chezmoidata/telemetry.toml)"
  if [ -n "$telemetry_off" ]; then show "$telemetry_off"; else echo "  all off"; fi
  section "macOS defaults (.chezmoidata/macos.toml)"; show "$macos_mismatch"
  section "Claude Code settings vs claude-settings.json"
  [ "$claude_sync" = true ] && echo "  in sync" || echo "  out of sync — run claude-sync"
  section "Claude Code MCP servers (claude + canary)"; show "$mcp_missing"
  section "Codex managed settings and MCP"
  [ "$codex_sync" = true ] && echo "  in sync (or group disabled)" || echo "  out of sync — chezmoi apply ~/.codex/config.toml"
  show "$codex_missing"
  section "tools missing in a minimal login/non-login shell"; show "$shell_missing"
  section "git: uncommitted or unpushed"
  show "$git_status"
  [ "$ahead" -gt 0 ] && echo "  $ahead commit(s) not pushed"
  [ "$behind" -gt 0 ] && echo "  $behind commit(s) behind origin — run chezmoi update"
  echo
  [ "$ok" = true ] && echo "✓ all good" || echo "✗ drift found"
fi
[ "$ok" = true ]
