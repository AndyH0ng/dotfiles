#!/bin/sh
# Report drift between ~/dotfiles and this machine. Changes nothing.
#   dotfiles-doctor          human-readable report
#   dotfiles-doctor --json   machine-readable (for agents and scripts)
# Exit status is 0 when everything is in sync, 1 when drift is found.
src=$(chezmoi source-path)

# chezmoi: target files that differ from the repo
chezmoi_drift=$(chezmoi status --exclude scripts)

# all Brewfiles combined, so "unlisted" means unlisted anywhere
all_brewfile=$(mktemp)
trap 'rm -f "$all_brewfile"' EXIT
cat "$src"/Brewfile "$src"/Brewfile.* > "$all_brewfile"
brew_missing=$(brew bundle check --file="$src/Brewfile" --no-upgrade --verbose 2>/dev/null \
  | sed -n 's/^→ [A-Za-z]* \(.*\) needs to be installed.*/\1/p')
brew_unlisted=$(brew bundle cleanup --file="$all_brewfile" 2>/dev/null | grep -vE '^(Would|Run )')

# Claude Code settings vs the repo copy (minus machine-local autoMode)
if jq 'del(.autoMode)' "$HOME/.claude/settings.json" | diff -q - "$src/claude-settings.json" >/dev/null; then
  claude_sync=true
else
  claude_sync=false
fi

# git state of the repo
git -C "$src" fetch -q 2>/dev/null
git_status=$(git -C "$src" status --short)
ahead=$(git -C "$src" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
behind=$(git -C "$src" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)

ok=true
# unlisted packages are informational: installed by hand, not managed
[ -n "$chezmoi_drift$brew_missing$git_status" ] && ok=false
[ "$claude_sync" = false ] || [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ] && ok=false

lines() { printf '%s\n' "$1" | jq -R . | jq -s 'map(select(length > 0))'; }

if [ "${1:-}" = "--json" ]; then
  jq -n \
    --argjson ok "$ok" \
    --argjson chezmoi "$(lines "$chezmoi_drift")" \
    --argjson missing "$(lines "$brew_missing")" \
    --argjson unlisted "$(lines "$brew_unlisted")" \
    --argjson claude "$claude_sync" \
    --argjson git "$(lines "$git_status")" \
    --argjson ahead "$ahead" --argjson behind "$behind" \
    '{ok: $ok,
      chezmoi_drift: $chezmoi,
      brew: {missing: $missing, unlisted: $unlisted},
      claude_settings_in_sync: $claude,
      git: {uncommitted: $git, ahead: $ahead, behind: $behind},
      fixes: {
        chezmoi_drift: "chezmoi diff, then chezmoi apply (repo wins) or edit the repo",
        brew_missing: "brew bundle --file ~/dotfiles/Brewfile",
        brew_unlisted: "informational; add to a Brewfile.* to manage it, or brew uninstall",
        claude_settings: "claude-sync",
        git_behind: "chezmoi update"
      }}'
else
  section() { printf '\n\033[1m%s\033[0m\n' "$1"; }
  show() { if [ -n "$1" ]; then printf '%s\n' "$1" | sed 's/^/  /'; else echo "  none"; fi; }
  section "chezmoi: files that differ from the repo"; show "$chezmoi_drift"
  section "Brewfile: listed but not installed"; show "$brew_missing"
  section "Brewfiles: installed but not listed (informational)"; show "$(printf '%s' "$brew_unlisted" | tr '\n' ' ')"
  section "Claude Code settings vs claude-settings.json"
  [ "$claude_sync" = true ] && echo "  in sync" || echo "  out of sync — run claude-sync"
  section "git: uncommitted or unpushed"
  show "$git_status"
  [ "$ahead" -gt 0 ] && echo "  $ahead commit(s) not pushed"
  [ "$behind" -gt 0 ] && echo "  $behind commit(s) behind origin — run chezmoi update"
  echo
  [ "$ok" = true ] && echo "✓ all good" || echo "✗ drift found"
fi
[ "$ok" = true ]
