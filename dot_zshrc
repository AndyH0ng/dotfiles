# ---- completion ----
autoload -Uz compinit
# full compinit at most once a day. The glob qualifier doesn't expand inside [[ ]].
_stale=(~/.zcompdump(N.mh+24))
if (( $#_stale )) || [[ ! -s ~/.zcompdump ]]; then
  compinit
  zcompile ~/.zcompdump
else
  compinit -C
fi
unset _stale

source ~/.config/zsh/theme.zsh
export LS_COLORS="$(vivid generate "$VIVID_THEME")"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---- tinty ----
export BASE16_SHELL_SET_BACKGROUND=false
TINTY_ARTIFACTS="$HOME/.local/share/tinted-theming/tinty/artifacts"
[ -f "$TINTY_ARTIFACTS/tinted-shell-scripts-file.sh" ] && . "$TINTY_ARTIFACTS/tinted-shell-scripts-file.sh"
[ -f "$TINTY_ARTIFACTS/tinted-fzf-sh-file.sh" ] && . "$TINTY_ARTIFACTS/tinted-fzf-sh-file.sh"

# ---- plugins ----
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
antidote load ~/.zsh_plugins.txt

# ---- prompt ----
eval "$(starship init zsh)"

# ---- dev tooling ----
eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"
source <(fzf --zsh)
eval "$(atuin init zsh)"

# ---- aliases ----
alias ll='eza -l --icons --group-directories-first'
alias la='eza -la --icons --group-directories-first'
alias tree='eza --tree --icons'
# abbreviations, not aliases: pasted commands with POSIX flags still get the real tool
abbr -S -q -f ls='eza --icons --group-directories-first' >/dev/null
abbr -S -q -f cat='bat --style=plain' >/dev/null
abbr -S -q -f grep='rg' >/dev/null
abbr -S -q -f find='fd' >/dev/null

# ---- history ----
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# ---- machine-local (not in git) ----
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# ---- syntax highlighting (must be last) ----
eval "$(/opt/homebrew/opt/zsh-patina/bin/zsh-patina activate)"

# ---- fastfetch ----
# on the first precmd, once the terminal has reported its size (else the logo misaligns)
autoload -Uz add-zsh-hook
_fastfetch_once() {
  fastfetch
  add-zsh-hook -d precmd _fastfetch_once
}
add-zsh-hook precmd _fastfetch_once
