source ~/.config/zsh/theme.zsh
# Regenerate colors only when the theme or vivid changes.
_colors_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/ls-colors-${VIVID_THEME}"
if [[ ! -s $_colors_cache || ~/.config/zsh/theme.zsh -nt $_colors_cache || ${commands[vivid]} -nt $_colors_cache ]]; then
  export LS_COLORS="$(vivid generate "$VIVID_THEME")"
  if [[ -n $LS_COLORS ]]; then
    mkdir -p "${_colors_cache:h}"
    print -rn -- "$LS_COLORS" > "${_colors_cache}.$$"
    mv -f "${_colors_cache}.$$" "$_colors_cache"
  fi
else
  export LS_COLORS="$(<"$_colors_cache")"
fi
unset _colors_cache
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# smart case: lowercase matches either case, uppercase only itself
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no                   # fzf-tab replaces the menu
zstyle ':completion:*:descriptions' format '[%d]' # fzf-tab needs this for groups
zstyle ':completion:*:git-checkout:*' sort false # keep git's recency order
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons=always -- "$realpath"'

# ---- tinty ----
export BASE16_SHELL_SET_BACKGROUND=false
TINTY_ARTIFACTS="$HOME/.local/share/tinted-theming/tinty/artifacts"
[ -f "$TINTY_ARTIFACTS/tinted-shell-scripts-file.sh" ] && . "$TINTY_ARTIFACTS/tinted-shell-scripts-file.sh"
[ -f "$TINTY_ARTIFACTS/tinted-fzf-sh-file.sh" ] && . "$TINTY_ARTIFACTS/tinted-fzf-sh-file.sh"

# ---- plugins ----
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
antidote load ~/.zsh_plugins.txt

# ---- prompt ----
eval "$(starship init zsh)"

# ---- dev tooling ----
eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"
# fd: respects .gitignore and includes dotfiles (fzf's own walker does neither)
export FZF_DEFAULT_COMMAND='fd --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview '[ -d {} ] && eza --tree --level=2 --color=always --icons=always -- {} || bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons=always -- {}'"
source <(fzf --zsh)
eval "$(atuin init zsh)"

# ---- aliases ----
alias ll='eza -l --icons --group-directories-first'
alias la='eza -la --icons --group-directories-first'
# abbreviations, not aliases: pasted commands with POSIX flags still get the real tool
abbr -S -q -f ls='eza --icons --group-directories-first' >/dev/null
abbr -S -q -f cat='bat --style=plain' >/dev/null
abbr -S -q -f tree='eza --tree --icons' >/dev/null
alias grep='ugrep -G --ignore-files --hidden -I --exclude-dir=.git'
alias find='bfs -regextype findutils-default'

# ---- history ----
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# ---- machine-local (not in git) ----
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# ---- syntax highlighting (must be last) ----
eval "$(/opt/homebrew/opt/zsh-patina/bin/zsh-patina activate)"

# ---- fastfetch ----
# on the first precmd, once the terminal has reported its size (else the logo misaligns)
autoload -Uz add-zsh-hook
_fastfetch_once() {
  fastfetch
  add-zsh-hook -d precmd _fastfetch_once
}
add-zsh-hook precmd _fastfetch_once
