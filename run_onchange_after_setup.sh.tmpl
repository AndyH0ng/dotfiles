#!/bin/bash
# Runs after files are written, so mise's and tinty's configs are in place.
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# theme: {{ .theme.scheme }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"

# language runtimes come from mise (brew is for CLIs and apps)
cd "$HOME" && mise install --yes

tinty install
tinty apply {{ .theme.scheme | quote }}

# Claude Code MCP: attach to the already-running Chrome Canary (logged-in
# profile) instead of launching a separate one. Needs remote debugging on in
# chrome://inspect/#remote-debugging. Remove first so arg changes apply.
if command -v claude >/dev/null 2>&1; then
  claude mcp remove chrome-devtools -s user >/dev/null 2>&1 || true
  claude mcp add chrome-devtools -s user -- \
    bunx chrome-devtools-mcp@latest --autoConnect --channel canary --no-usage-statistics
fi
