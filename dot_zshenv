# dedupe: brew shellenv, path_helper and mise all prepend
typeset -U path PATH

# here, not .zshrc, so non-interactive shells (agents, scripts) see them too
path=(~/.local/bin ~/.local/share/mise/shims ~/.bun/bin /opt/homebrew/bin /opt/homebrew/sbin $path)
[[ -n $CLAUDECODE || $DOTFILES_AGENT == codex ]] && path=(~/.local/agent-bin $path)

[[ -r ~/.config/zsh/telemetry.zsh ]] && source ~/.config/zsh/telemetry.zsh

# machine-local (not in git)
[[ -r ~/.zshenv.local ]] && source ~/.zshenv.local
