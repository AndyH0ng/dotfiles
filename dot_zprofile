eval "$(/opt/homebrew/bin/brew shellenv zsh)"
# OrbStack
[[ -r ~/.orbstack/shell/init.zsh ]] && source ~/.orbstack/shell/init.zsh

# Login setup reorders PATH; keep locked runtimes and agent commands first.
path=(~/.local/bin ~/.local/share/mise/shims ~/.bun/bin $path)
[[ -n $CLAUDECODE || $DOTFILES_AGENT == codex ]] && path=(~/.local/agent-bin $path)
