#!/bin/bash
# before files are written, so jq exists for modify_ scripts
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
{{- range .groups }}
# Brewfile.{{ .name }} hash: {{ include (print "Brewfile." .name) | sha256sum }}
{{- end }}
# opt-ins: {{ .install | toJson }}
set -euo pipefail

# .zshenv isn't loaded here
{{- range $k, $v := .telemetry.env }}
export {{ $k }}={{ $v | quote }}
{{- end }}

if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# trust the formula, not the whole tap
brew tap tinted-theming/tinted
brew trust --formula tinted-theming/tinted/tinty

brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/Brewfile"
{{- range .groups }}
{{-   if index $.install .name }}
brew bundle --no-upgrade --file="{{ $.chezmoi.sourceDir }}/Brewfile.{{ .name }}"
{{-   end }}
{{- end }}

# uv-tools.txt hash: {{ include "uv-tools.txt" | sha256sum }}
grep -vE '^\s*(#|$)' "{{ .chezmoi.sourceDir }}/uv-tools.txt" | while read -r tool; do
  uv tool install "$tool"
done

# telemetry opt-outs
{{- range .telemetry.commands }}
if command -v {{ .tool }} >/dev/null 2>&1; then
  {{ .run }}
fi
{{- end }}

# Claude Code MCP. Here, not the after-script: the first `claude` run on a fresh
# Mac rewrites ~/.claude/settings.json. Remove first so arg changes apply.
if command -v claude >/dev/null 2>&1; then
  claude mcp remove chrome-devtools -s user >/dev/null 2>&1 || true
  claude mcp add chrome-devtools -s user -- \
    bunx chrome-devtools-mcp@latest --autoConnect --channel canary --no-usage-statistics
fi

git -C "{{ .chezmoi.sourceDir }}" config core.hooksPath .githooks
