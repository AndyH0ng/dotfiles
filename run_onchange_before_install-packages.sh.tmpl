#!/bin/bash
# Runs before files are written, so tools like jq exist for modify_ scripts.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
{{- range .groups }}
# Brewfile.{{ .name }} hash: {{ include (print "Brewfile." .name) | sha256sum }}
{{- end }}
# opt-ins: {{ .install | toJson }}
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew analytics off
# Homebrew only loads third-party formulae that are explicitly trusted.
# Trust just tinty, not the whole tap.
brew tap tinted-theming/tinted
brew trust --formula tinted-theming/tinted/tinty

brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/Brewfile"
{{- range .groups }}
{{-   if index $.install .name }}
brew bundle --no-upgrade --file="{{ $.chezmoi.sourceDir }}/Brewfile.{{ .name }}"
{{-   end }}
{{- end }}

# Python CLIs that aren't in Homebrew (uv-tools.txt hash: {{ include "uv-tools.txt" | sha256sum }})
grep -vE '^\s*(#|$)' "{{ .chezmoi.sourceDir }}/uv-tools.txt" | while read -r tool; do
  uv tool install "$tool"
done

# telemetry settings that live in each tool's own config, not env vars
gh config set telemetry disabled
if command -v codex >/dev/null 2>&1; then
  mkdir -p "$HOME/.codex" && touch "$HOME/.codex/config.toml"
  grep -q '^\[analytics\]' "$HOME/.codex/config.toml" \
    || printf '\n[analytics]\nenabled = false\n' >> "$HOME/.codex/config.toml"
fi

# Claude Code MCP (runs before files are written: the first `claude`
# invocation on a fresh Mac touches ~/.claude/settings.json, which chezmoi
# then overwrites with the repo version). Attach to the already-running Chrome Canary (logged-in
# profile) instead of launching a separate one. Needs remote debugging on in
# chrome://inspect/#remote-debugging. Remove first so arg changes apply.
if command -v claude >/dev/null 2>&1; then
  claude mcp remove chrome-devtools -s user >/dev/null 2>&1 || true
  claude mcp add chrome-devtools -s user -- \
    bunx chrome-devtools-mcp@latest --autoConnect --channel canary --no-usage-statistics
fi

# block commits that contain secrets (this repo is public)
git -C "{{ .chezmoi.sourceDir }}" config core.hooksPath .githooks
