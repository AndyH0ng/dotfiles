#!/bin/sh
for tool in gitleaks shellcheck actionlint zizmor chezmoi ruff uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "pre-commit: $tool not installed — run 'brew bundle --file ~/dotfiles/packages/Brewfile'" >&2
    exit 1
  fi
done
"$(dirname "$0")/lint" || exit 1
exec gitleaks git --pre-commit --staged --no-banner --redact
