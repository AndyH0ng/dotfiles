{{- /* .chezmoidata isn't loaded yet at init, so read the group list directly */}}
{{- $groups := (include ".chezmoidata/packages.toml" | fromToml).groups }}
{{- $install := dict }}
{{- range $groups }}
{{-   $_ := set $install .name (promptBoolOnce $ (list "install" .name) (printf "Install Brewfile.%s (%s)" .name .description) false) }}
{{- end }}
sourceDir = {{ .chezmoi.sourceDir | quote }}
mode = "symlink"

[data.install]
{{- range $name, $on := $install }}
{{ $name }} = {{ $on }}
{{- end }}
