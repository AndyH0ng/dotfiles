# palette comes from .chezmoidata/theme.toml (standard base16 → ANSI mapping)
{{- $p := .theme.palette }}
palette = 0=#{{ $p.base00 }}
palette = 1=#{{ $p.base08 }}
palette = 2=#{{ $p.base0B }}
palette = 3=#{{ $p.base0A }}
palette = 4=#{{ $p.base0D }}
palette = 5=#{{ $p.base0E }}
palette = 6=#{{ $p.base0C }}
palette = 7=#{{ $p.base05 }}
palette = 8=#{{ $p.base03 }}
palette = 9=#{{ $p.base08 }}
palette = 10=#{{ $p.base0B }}
palette = 11=#{{ $p.base0A }}
palette = 12=#{{ $p.base0D }}
palette = 13=#{{ $p.base0E }}
palette = 14=#{{ $p.base0C }}
palette = 15=#{{ $p.base07 }}
foreground = #{{ $p.base05 }}
background = #{{ .theme.background }}

# fonts come from .chezmoidata/theme.toml (fallback order)
{{- range .theme.font.families }}
font-family = {{ .name }}
{{- end }}
font-size = {{ .theme.font.size }}

background-opacity = 0.85
background-blur = true

cursor-style = block
cursor-style-blink = false

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

window-colorspace = display-p3
quit-after-last-window-closed = true

macos-titlebar-style = tabs

macos-icon = custom
macos-custom-icon = ~/.config/ghostty/Terminal.icns
