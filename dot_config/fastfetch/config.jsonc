{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "position": "right"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "break",
    "packages",
    "shell",
    "theme",
    "break",
    "cpu",
    "memory",
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "showExternal": true
    },
    "break",
    {
      "type": "colors",
      "brightness": "normal"
    }
  ]
}
